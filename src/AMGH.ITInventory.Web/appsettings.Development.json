{
  "Storage": {
    "RootPath": "App_Data\\Documents"
  },
  "DataProtection": {
    "KeysPath": "App_Data\\Keys"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "File", "Args": { "path": "App_Data\\Logs\\dev-.log", "rollingInterval": "Day" } }
    ]
  }
}
