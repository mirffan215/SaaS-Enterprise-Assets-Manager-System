{
  "ConnectionStrings": {
    "AMGHDatabase": "Server=localhost;Database=AMGH_ITInventory;Trusted_Connection=True;Encrypt=True;TrustServerCertificate=True;Application Name=AMGH.ITInventory"
  },
  "Security": {
    "PasswordMinimumLength": 12,
    "PasswordHistoryCount": 5,
    "PasswordMaximumAgeDays": 90,
    "MaxFailedAccessAttempts": 5,
    "LockoutMinutes": 15,
    "SessionIdleTimeoutMinutes": 15,
    "SessionAbsoluteTimeoutHours": 8,
    "SecurityStampValidationMinutes": 5,
    "TemporaryPasswordLength": 16
  },
  "Storage": {
    "RootPath": "C:\\AMGH\\Documents"
  },
  "DataProtection": {
    "KeysPath": "C:\\AMGH\\Keys"
  },
  "Tenancy": {
    "Enabled": false,
    "BaseDomain": "",
    "AllowQueryParameter": false,
    "ServerConnectionString": "",
    "TenantConnectionTemplate": "",
    "ScriptsPath": "SQLScripts",
    "AppLogin": ""
  },
  "Labels": {
    "BaseUrl": ""
  },
  "Tags": {
    "PropertyOf": "PROPERTY OF",
    "CompanyName": "IT Inventory Cloud",
    "ContactLine": ""
  },
  "Display": {
    "TimeZone": "Arab Standard Time"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "C:\\AMGH\\Logs\\amgh-itinventory-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 90,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext} {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*"
}
