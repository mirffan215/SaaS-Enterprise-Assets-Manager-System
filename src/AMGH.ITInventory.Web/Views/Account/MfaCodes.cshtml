@model MfaCodesViewModel
@{
    ViewData["Title"] = Model.Heading;
}
<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-6">
        <h1 class="page-title">@Model.Heading</h1>
        <div class="alert alert-warning" role="alert">
            <strong>Save these recovery codes now.</strong> They are shown only once. Each works one time if you lose your phone. Keep them in a password manager or print them and store them safely.
        </div>
        <ul class="list-unstyled font-monospace fs-5 border rounded p-3 bg-body-tertiary">
            @foreach (var c in Model.Codes) { <li>@c</li> }
        </ul>
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">I have saved them</a>
    </div>
</div>
