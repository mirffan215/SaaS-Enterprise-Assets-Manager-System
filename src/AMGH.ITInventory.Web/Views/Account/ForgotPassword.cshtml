@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot password";
    Layout = "_LoginLayout";
}
<header class="lp-brand">
    <img class="lp-logo" src="@(Model.CompanyCode is null ? Url.Action("DefaultLogo", "Branding") : Url.Action("Logo", "Branding", new { code = Model.CompanyCode }))" alt="" />
    <p class="lp-name-en">@Model.CompanyName</p>
    <h1 class="lp-title">Forgot your password?</h1>
</header>
<div class="lp-text">
    <p>For security, passwords are reset by your company's IT administrators, who confirm who you are first.</p>
    <ol>
        <li>Contact your IT department@(Model.ContactEmail is null && Model.ContactPhone is null ? "." : ":")
            @if (Model.ContactEmail is not null) { <br /><i class="bi bi-envelope" aria-hidden="true"></i> <a href="mailto:@Model.ContactEmail">@Model.ContactEmail</a> }
            @if (Model.ContactPhone is not null) { <br /><i class="bi bi-telephone" aria-hidden="true"></i> @Model.ContactPhone }
        </li>
        <li>They reset it under <em>Administration → Users and roles</em> and give you a temporary password.</li>
        <li>Sign in with it; you will be asked to choose a new password straight away.</li>
    </ol>
    <p class="small text-body-secondary">Locked out after several wrong passwords? The lock lifts by itself after 15 minutes, or the IT department can unlock you now.</p>
</div>
<a class="lp-submit lp-submit-secondary" href="@Url.Action("Login", "Account", new { company = Model.CompanyCode })"><i class="bi bi-arrow-left" aria-hidden="true"></i> Back to sign in</a>
