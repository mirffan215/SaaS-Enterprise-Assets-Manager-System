@model ChangePasswordViewModel
@using Microsoft.Extensions.Options
@using AMGH.ITInventory.Security
@inject IOptions<SecurityOptions> Options
@{
    ViewData["Title"] = "Change password";
    var o = Options.Value;
}
<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
        <h1 class="page-title">Change password</h1>

        @if (Model.IsForced)
        {
            <div class="alert alert-warning" role="alert">
                Set a new password to continue. Your current password is temporary or has expired.
            </div>
        }

        <div class="row g-4">
            <div class="col-md-7">
                <form asp-action="ChangePassword" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    <div class="mb-3">
                        <label asp-for="CurrentPassword" class="form-label"></label>
                        <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" />
                        <span asp-validation-for="CurrentPassword" class="invalid-feedback d-block"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label"></label>
                        <input asp-for="NewPassword" class="form-control" autocomplete="new-password" aria-describedby="pwRules" />
                        <span asp-validation-for="NewPassword" class="invalid-feedback d-block"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label"></label>
                        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="invalid-feedback d-block"></span>
                    </div>
                    <button type="submit" class="btn btn-primary">Change password</button>
                    @if (!Model.IsForced)
                    {
                        <a class="btn btn-link" asp-controller="Home" asp-action="Index">Cancel</a>
                    }
                </form>
            </div>
            <div class="col-md-5">
                <div class="rules-panel" id="pwRules">
                    <h2 class="h6">Your new password must</h2>
                    <ul>
                        <li>be at least @o.PasswordMinimumLength characters long</li>
                        <li>mix upper- and lower-case letters, digits and symbols</li>
                        <li>not contain your username or name</li>
                        <li>not be a common word or keyboard pattern such as "Qwerty" or "123456"</li>
                        @if (o.PasswordHistoryCount > 0)
                        {
                            <li>differ from your last @o.PasswordHistoryCount passwords</li>
                        }
                    </ul>
                    <p class="small mb-0">A short phrase of unrelated words with a number and a symbol is strong and easy to remember.</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
