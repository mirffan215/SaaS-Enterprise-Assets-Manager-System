@model LoginViewModel
@{
    ViewData["Title"] = "Sign in";
    Layout = "_LoginLayout";
    // no company chosen: direct sign-in (the person's default company is used after the password is checked)
    var direct = string.IsNullOrEmpty(Model.CompanyCode);
    var logo = Model.LogoUrl ?? Url.Action("DefaultLogo", "Branding");
}
<header class="lp-brand">
    <img class="lp-logo" src="@logo" alt="@Model.CompanyName" />
    @if (!string.IsNullOrWhiteSpace(Model.NameArabic)) { <p class="lp-name-ar" lang="ar" dir="rtl">@Model.NameArabic</p> }
    <p class="lp-name-en">@Model.CompanyName</p>
    <h1 class="lp-title">@AMGH.ITInventory.Shared.AppInfo.Name</h1>
    <p class="lp-tagline">@AMGH.ITInventory.Shared.AppInfo.Tagline</p>
</header>

<p class="lp-context">
    @if (direct)
    {
        <span>Sign in with your user name or e-mail. You go straight to your company.</span>
        @if (Model.CanChangeCompany) { <a href="@Url.Action("Login", "Account", new { change = true, returnUrl = Model.ReturnUrl })">Choose a company instead</a> }
    }
    else
    {
        <span>Signing in to <strong>@Model.CompanyName</strong></span>
        @if (Model.CanChangeCompany) { <a href="@Url.Action("Login", "Account", new { change = true, returnUrl = Model.ReturnUrl })">Change company</a> }
    }
</p>

@if (Model.SessionExpired)
{
    <div class="alert alert-info py-2" role="status">You were signed out after a period of inactivity. Sign in to continue.</div>
}

<form asp-action="Login" method="post" novalidate class="lp-form">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
    <input type="hidden" asp-for="ReturnUrl" />
    <input type="hidden" asp-for="CompanyCode" />

    <div class="lp-field">
        <label asp-for="Username" class="visually-hidden"></label>
        <i class="bi bi-envelope" aria-hidden="true"></i>
        <input asp-for="Username" class="form-control" placeholder="User name or e-mail" autocomplete="username" />
    </div>
    <span asp-validation-for="Username" class="invalid-feedback d-block"></span>

    <div class="lp-field">
        <label asp-for="Password" class="visually-hidden"></label>
        <i class="bi bi-lock-fill" aria-hidden="true"></i>
        <input asp-for="Password" class="form-control" placeholder="Password" autocomplete="current-password" />
        <button type="button" class="lp-eye" data-toggle-password="Password" aria-label="Show password" aria-pressed="false"><i class="bi bi-eye" aria-hidden="true"></i></button>
    </div>
    <span asp-validation-for="Password" class="invalid-feedback d-block"></span>

    <div class="lp-options">
        <div class="form-check mb-0">
            <input class="form-check-input" type="checkbox" asp-for="RememberMe" />
            <label class="form-check-label" asp-for="RememberMe" title="Remembers your user name on this computer. You are still signed out after inactivity.">Remember me</label>
        </div>
        <a href="@Url.Action("ForgotPassword", "Account", new { company = Model.CompanyCode })">Forgot password?</a>
    </div>

    <button type="submit" class="lp-submit">Sign in <i class="bi bi-arrow-right" aria-hidden="true"></i></button>
</form>

<ul class="lp-features" aria-label="What the system offers">
    <li><i class="bi bi-shield-check" aria-hidden="true"></i><span>Secure access</span></li>
    <li><i class="bi bi-buildings" aria-hidden="true"></i><span>Multi company</span></li>
    <li><i class="bi bi-qr-code-scan" aria-hidden="true"></i><span>QR tracking</span></li>
    <li><i class="bi bi-bar-chart-fill" aria-hidden="true"></i><span>Real-time reporting</span></li>
</ul>
<p class="lp-notice">@(Model.LoginTagline ?? $"For authorised {Model.CompanyName} users only. Sign-ins and changes are logged.")</p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
