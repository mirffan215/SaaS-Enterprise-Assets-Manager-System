@model TemporaryPasswordViewModel
@{
    ViewData["Title"] = "Temporary password";
}
<div class="row justify-content-center">
    <div class="col-lg-7">
        <h1 class="page-title">@(Model.IsNewUser ? $"{Model.Username} has been created" : $"Password reset for {Model.Username}")</h1>
        <section class="panel">
            <p>Give this temporary password to the person directly, in person or by phone. Don't send it by e-mail.</p>
            <div class="temp-password">
                <code id="tempPassword">@Model.TemporaryPassword</code>
                <button type="button" class="btn btn-outline-primary" data-copy-target="#tempPassword">
                    <i class="bi bi-clipboard" aria-hidden="true"></i> Copy
                </button>
            </div>
            <p class="small text-body-secondary">This is the only time the password is shown. They must set their own password when they first sign in.</p>
            <a class="btn btn-primary" asp-action="Index">Done</a>
        </section>
    </div>
</div>
