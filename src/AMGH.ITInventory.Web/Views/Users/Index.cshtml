@model UserListViewModel
@inject IDisplayTime Time
@{
    ViewData["Title"] = "Users and roles";
}
<div class="page-head">
    <h1 class="page-title">Users and roles</h1>
    @if (Model.CanManage)
    {
        <a class="btn btn-primary" asp-action="Create"><i class="bi bi-person-plus" aria-hidden="true"></i> Add a user</a>
    }
</div>

<div class="table-responsive panel p-0">
    <table class="table table-hover align-middle mb-0">
        <thead>
            <tr>
                <th scope="col">Username</th>
                <th scope="col">Name</th>
                <th scope="col">Roles</th>
                <th scope="col">Status</th>
                <th scope="col">Last sign-in (@Time.ZoneLabel)</th>
                @if (Model.CanManage) { <th scope="col"><span class="visually-hidden">Actions</span></th> }
            </tr>
        </thead>
        <tbody>
            @foreach (var u in Model.Users)
            {
                <tr class="@(u.IsActive ? "" : "row-muted")">
                    <td class="fw-semibold">@u.Username</td>
                    <td>@u.DisplayName<div class="small text-body-secondary">@u.Email</div></td>
                    <td>@string.Join(", ", u.Roles)</td>
                    <td>
                        @if (!u.IsActive) { <span class="badge text-bg-secondary">Disabled</span> }
                        else if (u.IsLockedOut) { <span class="badge text-bg-danger">Locked</span> }
                        else if (u.MustChangePassword) { <span class="badge text-bg-warning">Password change due</span> }
                        else { <span class="badge text-bg-success">Active</span> }
                    </td>
                    <td>@Time.Format(u.LastLoginDateUtc)</td>
                    @if (Model.CanManage)
                    {
                        <td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@u.UserId">Edit</a></td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>
