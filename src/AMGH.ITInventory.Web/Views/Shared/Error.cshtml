@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
    Layout = User.Identity?.IsAuthenticated == true ? "_Layout" : "_LoginLayout";
}
<div class="app-message">
    <h1>Something went wrong</h1>
    <p>The request could not be completed. The error has been logged.</p>
    <p class="text-body-secondary small">If you contact the IT department, quote reference <code>@Model.RequestId</code>.</p>
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Go to the overview</a>
</div>
