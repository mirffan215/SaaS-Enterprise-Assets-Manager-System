@model SecuritySettingsViewModel
@{
    ViewData["Title"] = "Sign-in security";
}
<h1 class="page-title">Sign-in security</h1>
@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert @(Model.Succeeded ? "alert-success" : "alert-danger")" role="status">@Model.Message</div>
}
<form asp-action="Save" method="post" novalidate>
    <section class="panel mb-3">
        <h2 class="panel-title">Two-step verification</h2>
        <p class="small">With two-step verification a person enters a code from an app on their phone as well as their password. Anyone can turn it on for themselves under their profile menu; this sets what the company requires.</p>
        <div class="form-check"><input class="form-check-input" type="radio" name="MfaPolicy" id="mfa0" value="0" checked="@(Model.MfaPolicy == 0)" /><label class="form-check-label" for="mfa0">Optional</label></div>
        <div class="form-check"><input class="form-check-input" type="radio" name="MfaPolicy" id="mfa1" value="1" checked="@(Model.MfaPolicy == 1)" /><label class="form-check-label" for="mfa1">Required for administrators (people who manage users or roles)</label></div>
        <div class="form-check"><input class="form-check-input" type="radio" name="MfaPolicy" id="mfa2" value="2" checked="@(Model.MfaPolicy == 2)" /><label class="form-check-label" for="mfa2">Required for everyone</label></div>
        <p class="small text-body-secondary mt-2 mb-0">A person who must use it but has not set it up yet is taken to the setup page at their next sign-in. People who use single sign-on are covered by their provider's own second step.</p>
    </section>

    <section class="panel mb-3">
        <h2 class="panel-title">Allowed networks</h2>
        <p class="small">Leave empty to allow sign-in from anywhere. Otherwise only these addresses can sign in or keep a session open: single addresses and ranges, separated by commas or lines (for example <code>203.0.113.7, 10.20.0.0/16</code>). Your address now is <strong>@Model.CurrentIp</strong>.</p>
        <textarea asp-for="AllowedIpRanges" class="form-control font-monospace" rows="3" maxlength="1000" placeholder="203.0.113.7&#10;10.20.0.0/16"></textarea>
        <p class="small text-body-secondary mt-2 mb-0">You cannot save a list that excludes your own address. If a mistake still locks everybody out, the operator can clear it from the platform console (Emergency access).</p>
    </section>

    <section class="panel mb-3">
        <h2 class="panel-title">Single sign-on (OpenID Connect)</h2>
        <p class="small">Lets people sign in with the company's Microsoft Entra ID, Google Workspace or another OpenID Connect provider. The person must already have an account here with the same e-mail address; nobody is created automatically.</p>
        <div class="form-check form-switch mb-2"><input class="form-check-input" type="checkbox" asp-for="SsoEnabled" /><label class="form-check-label" asp-for="SsoEnabled">Show "Sign in with single sign-on" on the sign-in page</label></div>
        <div class="row g-2">
            <div class="col-md-12"><label asp-for="SsoAuthority" class="form-label small">Provider address</label><input asp-for="SsoAuthority" class="form-control" placeholder="https://login.microsoftonline.com/<directory id>/v2.0  or  https://accounts.google.com" /></div>
            <div class="col-md-6"><label asp-for="SsoClientId" class="form-label small">Client (application) id</label><input asp-for="SsoClientId" class="form-control" autocomplete="off" /></div>
            <div class="col-md-6"><label asp-for="SsoClientSecret" class="form-label small">Client secret @(Model.SsoSecretSet ? "(saved: leave empty to keep it)" : "")</label><input asp-for="SsoClientSecret" class="form-control" type="password" autocomplete="new-password" /></div>
            <div class="col-md-6"><label asp-for="SsoAllowedDomain" class="form-label small">Only e-mail addresses of this domain (optional)</label><input asp-for="SsoAllowedDomain" class="form-control" placeholder="example.com" /></div>
        </div>
        <p class="small text-body-secondary mt-2 mb-0">Register this redirect address with your provider: <code>@Model.RedirectUri</code></p>
    </section>
    <button type="submit" class="btn btn-primary">Save</button>
</form>

<section class="panel mt-4">
    <h2 class="panel-title">People and two-step verification</h2>
    <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
            <thead><tr><th>User</th><th>Name</th><th>Two-step</th><th></th></tr></thead>
            <tbody>
                @foreach (var p in Model.People)
                {
                    <tr>
                        <td>@p.Username</td>
                        <td>@p.DisplayName</td>
                        <td>@if (p.Enabled) { <span class="badge text-bg-success">On</span> } else { <span class="badge text-bg-secondary">Off</span> }</td>
                        <td class="text-end">
                            @if (p.Enabled)
                            {
                                <form asp-action="Reset" asp-route-userId="@p.UserId" method="post" class="d-inline" data-confirm="Turn off two-step verification for @p.Username? They will set it up again.">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Reset</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="small text-body-secondary mt-2 mb-0">Reset is for a lost or replaced phone. The person keeps their account and password.</p>
</section>
