@model ErrorViewModel
@{
    var (title, text) = Model.StatusCode switch
    {
        404 => ("Page not found", "The page or record you asked for doesn't exist or has been removed."),
        403 => ("No access", "Your account doesn't have permission to open this page."),
        429 => ("Too many attempts", "Too many requests from your computer. Wait a minute and try again."),
        _ => ("Request not completed", $"The server returned status {Model.StatusCode}.")
    };
    ViewData["Title"] = title;
    Layout = User.Identity?.IsAuthenticated == true ? "_Layout" : "_LoginLayout";
}
<div class="app-message">
    <h1>@title</h1>
    <p>@text</p>
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Go to the overview</a>
</div>
