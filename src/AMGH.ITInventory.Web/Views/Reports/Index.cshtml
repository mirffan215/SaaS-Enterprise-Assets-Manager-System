@model ReportCentreViewModel
@{ ViewData["Title"] = "Reports"; }
<div class="page-head">
    <div>
        <h1 class="page-title">Reports</h1>
        <p class="text-body-secondary mb-0">Reports cover @User.GetCompanyName() only. Choose a report, set filters and columns, then export.</p>
    </div>
    <a class="btn btn-outline-secondary" asp-action="History"><i class="bi bi-clock-history" aria-hidden="true"></i> Generation history</a>
</div>
<div class="report-cards">
    @foreach (var r in Model.Reports)
    {
        <a class="report-card" asp-action="Run" asp-route-code="@r.Code">
            <i class="bi @r.Icon report-card-icon" aria-hidden="true"></i>
            <span class="report-card-title">@r.Title</span>
            <span class="report-card-text">@r.Description</span>
            <span class="badge text-bg-light">@r.Confidentiality</span>
        </a>
    }
</div>
<div class="row g-4 mt-1">
    <div class="col-lg-6">
        <section class="panel">
            <h2 class="panel-title">Saved reports</h2>
            @if (Model.Saved.Count == 0) { <p class="text-body-secondary small mb-0">Save a report's filters and columns from the report page to find them here.</p> }
            <ul class="list-unstyled mb-0">
                @foreach (var s in Model.Saved)
                {
                    <li class="saved-item">
                        <a href="@(Url.Action("Run", new { code = s.ReportCode }) + "?" + s.QueryString)">@s.Name</a>
                        <span class="small text-body-secondary">@(Model.Reports.FirstOrDefault(r => r.Code == s.ReportCode)?.Title) · @(s.IsMine ? "mine" : "shared by " + s.CreatedBy)</span>
                        @if (s.IsMine)
                        {
                            <form asp-action="DeleteSaved" asp-route-id="@s.SavedReportId" method="post" class="d-inline" data-confirm="Delete the saved report '@s.Name'?">
                                <button type="submit" class="btn btn-link btn-sm text-danger p-0 ms-2">Delete</button>
                            </form>
                        }
                    </li>
                }
            </ul>
        </section>
    </div>
    <div class="col-lg-6">
        <section class="panel">
            <h2 class="panel-title">Recently generated</h2>
            @if (Model.Recent.Count == 0) { <p class="text-body-secondary small mb-0">Exports and printed reports appear here.</p> }
            <ul class="list-unstyled mb-0 small">
                @foreach (var h in Model.Recent) { <li>@Time.Format(h.RunDateUtc) · <strong>@h.ReportTitle</strong> · @h.Format · @h.RowCount rows · @h.RunBy</li> }
            </ul>
        </section>
    </div>
</div>
