@model IReadOnlyList<AMGH.ITInventory.Application.Lifecycle.PendingApproval>
@{ ViewData["Title"] = "Approval Center"; var mine = Model.Where(p => p.CanDecide).ToList(); var others = Model.Where(p => !p.CanDecide).ToList(); }
<div class="page-head">
    <div>
        <h1 class="page-title">Approval Center</h1>
        <p class="text-body-secondary mb-0">Movement and disposal requests waiting for a decision. Requesters can never approve their own requests.</p>
    </div>
    @if (User.HasPermission(Permissions.Administration.RolesManage)) { <a class="btn btn-outline-secondary" asp-action="Rules"><i class="bi bi-diagram-3" aria-hidden="true"></i> Approval stages</a> }
</div>
<h2 class="h5">Waiting for you (@mine.Count)</h2>
@if (mine.Count == 0) { <p class="text-body-secondary">Nothing waits for your decision.</p> }
@foreach (var p in mine)
{
    <section class="panel approval-card">
        <div class="d-flex flex-wrap justify-content-between gap-2">
            <div>
                <span class="badge @(p.RequestType == "Disposal" ? "text-bg-danger" : "text-bg-primary")">@p.RequestType</span>
                <span class="ms-1"><partial name="_DocLink" model='(p.DocumentNumber, p.RequestType == "Movement" ? "MOV" : "DSP", p.RequestId)' /></span>
                <a class="fw-semibold ms-1" asp-controller="Assets" asp-action="Details" asp-route-id="@p.AssetId">@p.AssetNumber</a> @p.AssetName
                <div class="mt-1">@p.Summary</div>
                <div class="small text-body-secondary">Reason: @p.Reason</div>
                <div class="small text-body-secondary">Requested by @p.RequestedBy, @Time.Format(p.RequestedUtc) · Stage @p.Stage of @p.TotalStages@(p.StageRole is null ? "" : " (" + AMGH.ITInventory.Application.Common.DisplayText.Humanize(p.StageRole) + ")")</div>
                @foreach (var s in p.Steps) { <div class="small text-success"><i class="bi bi-check2" aria-hidden="true"></i> Stage @s.StageNo approved by @s.DecidedBy @(s.Remarks is null ? "" : "— " + s.Remarks)</div> }
            </div>
            <div class="approval-actions">
                <form asp-action="Approve" asp-route-type="@p.RequestType" asp-route-id="@p.RequestId" method="post" class="d-flex gap-2 mb-2">
                    <input class="form-control form-control-sm" name="remarks" maxlength="1000" placeholder="Remarks (optional)" aria-label="Remarks" />
                    <button class="btn btn-sm btn-success text-nowrap" type="submit"><i class="bi bi-check-lg" aria-hidden="true"></i> Approve</button>
                </form>
                <form asp-action="Reject" asp-route-type="@p.RequestType" asp-route-id="@p.RequestId" method="post" class="d-flex gap-2">
                    <input class="form-control form-control-sm" name="reason" maxlength="500" placeholder="Reason for rejecting" aria-label="Reason for rejecting" required />
                    <button class="btn btn-sm btn-outline-danger text-nowrap" type="submit">Reject</button>
                </form>
            </div>
        </div>
    </section>
}
@if (others.Count > 0)
{
    <h2 class="h5 mt-4">Other open requests (@others.Count)</h2>
    <div class="table-responsive panel p-0">
        <table class="table table-sm align-middle mb-0">
            <thead><tr><th>Type</th><th>Asset</th><th>Request</th><th>Requested by</th><th>Stage</th><th>Waiting for</th></tr></thead>
            <tbody>
                @foreach (var p in others)
                {
                    <tr><td>@p.RequestType</td><td><a asp-controller="Assets" asp-action="Details" asp-route-id="@p.AssetId">@p.AssetNumber</a></td><td class="small">@p.Summary</td>
                        <td>@p.RequestedBy</td><td>@p.Stage / @p.TotalStages</td><td class="small text-body-secondary">@p.WhyNot</td></tr>
                }
            </tbody>
        </table>
    </div>
}
