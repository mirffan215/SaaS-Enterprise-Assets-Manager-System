@model MasterDataListViewModel
@{
    ViewData["Title"] = Model.Type.Title;
    var p = Model.Page;
}
<div class="page-head">
    <div>
        <a class="small" asp-action="Index">Master data</a>
        <h1 class="page-title">@Model.Type.Title</h1>
    </div>
    @if (Model.CanManage && Model.AllowCreate)
    {
        <a class="btn btn-primary" href="@Url.Action("Create", new { type = Model.Type.Key })"><i class="bi bi-plus-lg" aria-hidden="true"></i> Add @Model.Type.SingularTitle.ToLowerInvariant()</a>
    }
</div>
<p class="text-body-secondary">@Model.Type.Description</p>

<form method="get" class="panel filter-bar" role="search">
    <div class="filter-search">
        <label for="q" class="form-label">Search</label>
        <input id="q" name="q" value="@Model.Search" class="form-control" />
    </div>
    <div class="filter-checks">
        <div class="form-check"><input class="form-check-input" type="checkbox" id="inactive" name="inactive" value="true" checked="@Model.IncludeInactive" /><label class="form-check-label" for="inactive">Include inactive</label></div>
    </div>
    <div class="filter-actions">
        <button type="submit" class="btn btn-primary">Search</button>
        <a href="@Url.Action("List", new { type = Model.Type.Key })" class="btn btn-link">Clear</a>
    </div>
</form>

<div class="table-responsive panel p-0">
    <table class="table table-hover align-middle mb-0">
        <thead>
            <tr>
                @foreach (var c in p.Columns) { <th scope="col">@c.Label</th> }
                @if (Model.CanManage) { <th scope="col"><span class="visually-hidden">Actions</span></th> }
            </tr>
        </thead>
        <tbody>
            @foreach (var row in p.Rows)
            {
                <tr class="@(row.IsActive ? "" : "row-muted")">
                    @foreach (var cell in row.Cells) { <td>@(cell ?? "—")</td> }
                    @if (Model.CanManage)
                    {
                        <td class="text-end"><a class="btn btn-sm btn-outline-primary" href="@Url.Action("Edit", new { type = Model.Type.Key, id = row.Id })">Edit</a></td>
                    }
                </tr>
            }
            @if (p.Rows.Count == 0)
            {
                <tr><td colspan="@(p.Columns.Count + 1)" class="text-center text-body-secondary py-4">No records.</td></tr>
            }
        </tbody>
    </table>
</div>

@if (p.TotalPages > 1)
{
    <nav aria-label="Pages" class="mt-3">
        <ul class="pagination">
            @for (var i = 1; i <= p.TotalPages; i++)
            {
                <li class="page-item @(i == p.Page ? "active" : "")">
                    <a class="page-link" href="@Url.Action("List", new { type = Model.Type.Key, q = Model.Search, inactive = Model.IncludeInactive, page = i })">@i</a>
                </li>
            }
        </ul>
    </nav>
}
