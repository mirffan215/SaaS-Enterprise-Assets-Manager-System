@model IReadOnlyList<AMGH.ITInventory.Security.Platform.CompanyListItem>
@using AMGH.ITInventory.Domain.Entities
@{ ViewData["Title"] = "Companies"; }
<div class="page-head">
    <div>
        <h1 class="page-title">Companies</h1>
        <p class="text-body-secondary mb-0">Company workspaces on this platform. Each company's data is isolated from the others.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg" aria-hidden="true"></i> Create company</a>
</div>
<div class="table-responsive panel p-0">
    <table class="table align-middle mb-0">
        <thead><tr><th>Company</th><th>Code</th><th>Status</th><th>Active users</th><th>Created</th><th><span class="visually-hidden">Actions</span></th></tr></thead>
        <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td><span class="fw-semibold">@c.DisplayName</span><div class="small text-body-secondary">@c.LegalName</div></td>
                    <td><code>@c.CompanyCode</code></td>
                    <td>
                        <span class="badge status-company-@c.Status.ToLowerInvariant()">@c.Status</span>
                        @if (!c.SetupComplete) { <span class="badge text-bg-warning">setup incomplete</span> }
                    </td>
                    <td>@c.ActiveMembers</td>
                    <td class="small">@Time.Date(c.CreatedDateUtc)</td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@c.CompanyId">Edit</a>
                        @if (!c.SetupComplete)
                        {
                            <form asp-action="CompleteSetup" asp-route-id="@c.CompanyId" method="post" class="d-inline">
                                <button class="btn btn-sm btn-warning" type="submit">Complete setup</button>
                            </form>
                        }
                        @if (c.Status == CompanyStatuses.Active)
                        {
                            <form asp-controller="Account" asp-action="SwitchCompany" method="post" class="d-inline">
                                <input type="hidden" name="company" value="@c.CompanyCode" />
                                <button class="btn btn-sm btn-outline-secondary" type="submit" title="Sign out and sign in to this company">Open</button>
                            </form>
                            @if (c.CompanyCode != "AMGH")
                            {
                                <form asp-action="Status" asp-route-id="@c.CompanyId" method="post" class="d-inline"
                                      data-confirm="Suspend @c.DisplayName? Its users are signed out and cannot sign in until it is reactivated.">
                                    <input type="hidden" name="status" value="@CompanyStatuses.Suspended" />
                                    <button class="btn btn-sm btn-outline-warning" type="submit">Suspend</button>
                                </form>
                            }
                        }
                        else if (c.SetupComplete)
                        {
                            <form asp-action="Status" asp-route-id="@c.CompanyId" method="post" class="d-inline">
                                <input type="hidden" name="status" value="@CompanyStatuses.Active" />
                                <button class="btn btn-sm btn-outline-success" type="submit">Reactivate</button>
                            </form>
                        }
                        @if (c.Status == CompanyStatuses.Suspended)
                        {
                            <form asp-action="Status" asp-route-id="@c.CompanyId" method="post" class="d-inline"
                                  data-confirm="Archive @c.DisplayName? Its records are kept for audit but nobody can sign in.">
                                <input type="hidden" name="status" value="@CompanyStatuses.Archived" />
                                <button class="btn btn-sm btn-outline-danger" type="submit">Archive</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<p class="small text-body-secondary mt-2">Companies are never deleted: archiving keeps all records for audit. "Open" signs you out and into that company; as Platform Administrator you can open any company, and the access is recorded in its sign-in history.</p>
